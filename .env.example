# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — geração de letra. Sem chave = letra simulada (modo mock) em dev.
ANTHROPIC_API_KEY=
LYRICS_PROVIDER=

# Geração musical — Eleven Music API (ElevenLabs). Crie a chave em
# elevenlabs.io/app/settings/api-keys. Sem chave = música simulada em dev.
MUSIC_PROVIDER=
MUSIC_API_KEY=

# Woovi — Pix. Sem chave = pagamento simulado, que se auto-confirma em alguns
# segundos (útil para testar o desbloqueio automático sem conta na Woovi).
PAYMENT_PROVIDER=
WOOVI_APP_ID=
WOOVI_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GIFT_PRICE_CENTS=4990
