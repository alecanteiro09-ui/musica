# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — geração de letra. Sem chave = letra simulada (modo mock) em dev.
ANTHROPIC_API_KEY=
LYRICS_PROVIDER=

# Geração musical — Suno via Kie.ai (kie.ai/suno-api). Suno não tem API
# comercial oficial pública; isto usa uma camada não-oficial por decisão
# consciente de risco (ver aviso completo em lib/ai/providers/real-music.ts).
# Crie a chave em kie.ai. Sem chave = música simulada em dev.
MUSIC_PROVIDER=
MUSIC_API_KEY=

# Woovi — Pix. Sem chave = pagamento simulado, que se auto-confirma em alguns
# segundos (útil para testar o desbloqueio automático sem conta na Woovi).
PAYMENT_PROVIDER=
WOOVI_APP_ID=
WOOVI_WEBHOOK_SECRET=

# E-mail — backup de entrega (a entrega principal já acontece na hora, na
# tela). Crie a chave em resend.com; sem domínio verificado lá, só consegue
# mandar pro próprio e-mail da conta (modo sandbox). Sem chave = só loga no
# console em dev.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Notificação push a cada venda confirmada, via ntfy (app grátis: ntfy.sh).
# Instale o app "ntfy" no celular e assine um tópico com esse mesmo nome —
# use algo aleatório e não-óbvio, porque tópicos do ntfy.sh são públicos por
# padrão (quem souber o nome também recebe as notificações). Sem chave =
# notificação desativada.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GIFT_PRICE_CENTS=4990

# Pixels de rastreamento (Meta, TikTok, Google Ads) — PageView, AddToCart,
# AddPaymentInfo e Purchase já estão instalados em todo o funil (ver
# lib/analytics/track.ts e lib/tracking/). Sem os IDs/tokens abaixo, cada
# pixel fica desligado silenciosamente — preencha e faça um novo deploy pra
# ativar, sem precisar mexer em código.
#
# Meta (Facebook/Instagram) — Gerenciador de Eventos (business.facebook.com/events_manager):
#   NEXT_PUBLIC_META_PIXEL_ID: aba "Configurações" do pixel, é só um número.
#   META_CONVERSIONS_API_TOKEN: aba "Configurações" → "Conversions API" →
#     "Gerar token de acesso" (dá acesso total a esse pixel — trate como senha).
#   META_TEST_EVENT_CODE: aba "Testar eventos", só durante validação (opcional).
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=

# TikTok Ads — TikTok Ads Manager → Assets → Events (ads.tiktok.com):
#   NEXT_PUBLIC_TIKTOK_PIXEL_ID: o "Pixel Code" do pixel.
#   TIKTOK_EVENTS_API_ACCESS_TOKEN: dentro do pixel → "Configurar" → "Definir
#     manualmente" → "Gerar token de acesso" (Events API).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# Google Ads — cada ação de conversão tem seu próprio rótulo; crie uma
# conversão pra cada evento em Ferramentas e configurações → Conversões
# (ads.google.com), tipo "Site". O ID e o rótulo aparecem juntos na tag,
# formato "AW-XXXXXXXXX/AbCdEfGhIj" — separe as duas partes abaixo.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_ADD_TO_CART=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_ADD_PAYMENT_INFO=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PURCHASE=

# Painel /admin (dados de visitante + mapa de calor, ver app/admin) — senha
# única, sem cadastro de usuário. Sem essa variável configurada, /admin fica
# permanentemente bloqueado (login sempre falha).
ADMIN_PASSWORD=
